{
  "name": "agent-maestro",
  "version": "2.1.0",
  "description": "Meta-orchestrator CLI for collaborative AI agents (Claude Code, Gemini CLI, Codex)",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "maestro": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/cli/index.js",
    "dev": "tsc && node --watch dist/cli/index.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "tsc --project tsconfig.test.json && node dist/tests/tests/test-basic.js"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "orchestration",
    "claude",
    "gemini",
    "codex",
    "multi-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^10.0.0",
    "node-pty": "^1.0.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.25",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
